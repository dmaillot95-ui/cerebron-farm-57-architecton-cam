{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "evidence_id",
    "level",
    "status",
    "limitations"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "level": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "E6",
        "E7",
        "E8"
      ]
    },
    "status": {
      "enum": [
        "VERIFIED",
        "SUPPORTED",
        "PRELIMINARY",
        "CONTRADICTORY",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "limitations": {
      "type": "array"
    }
  }
}